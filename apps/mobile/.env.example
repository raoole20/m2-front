# Base URL for the m2-back API consumed by @m2/api-client.
# Used by apps/mobile/src/lib/api.ts.
#
# Local dev (iOS Simulator + Android Emulator pointing at host loopback):
#   EXPO_PUBLIC_API_URL=http://localhost:3000/api
#
# Android physical device on the same LAN — replace <LAN-IP> with your dev
# machine's LAN address (e.g. 192.168.1.42). `localhost` resolves to the
# device itself and the request will fail (Risk R6).
#   EXPO_PUBLIC_API_URL=http://<LAN-IP>:3000/api
EXPO_PUBLIC_API_URL=
